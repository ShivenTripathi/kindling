{
  "name": "kindling",
  "version": "0.1.0",
  "description": "Send Chrome tabs you left open for 48+ hours to your Kindle as a beautiful, readable EPUB digest — entirely from your own machine.",
  "type": "module",
  "bin": {
    "kindling": "src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test 'test/**/*.test.js'",
    "typecheck": "tsc --checkJs --noEmit --allowJs --skipLibCheck --target es2022 --module nodenext --moduleResolution nodenext src/*.js src/**/*.js",
    "lint": "eslint src test",
    "format": "prettier --write ."
  },
  "keywords": [
    "kindle",
    "epub",
    "chrome",
    "tabs",
    "read-later",
    "readability",
    "send-to-kindle"
  ],
  "author": "Shiven Tripathi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShivenTripathi/kindling.git"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "commander": "^12.1.0",
    "defuddle": "^0.19.1",
    "jsdom": "^25.0.0",
    "linkedom": "^0.18.13",
    "undici": "^6.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
